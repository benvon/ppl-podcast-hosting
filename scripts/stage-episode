#!/usr/bin/env bash
set -euo pipefail

if [[ $# -ne 1 ]]; then
  echo "usage: $0 /absolute/path/to/local-release-directory" >&2
  exit 64
fi

release_dir=$1
if [[ ! -d "$release_dir" || ! -f "$release_dir/episode.yaml" || ! -f "$release_dir/show-notes.md" || ! -f "$release_dir/audio.mp3" || ! -f "$release_dir/source-release-seal.yaml" ]]; then
  echo "release directory must contain episode.yaml, show-notes.md, audio.mp3, and source-release-seal.yaml" >&2
  exit 64
fi

handoff_episode_id=$(awk -F: '$1 == "id" { gsub(/[[:space:]\"'"'"']/, "", $2); print $2; exit }' "$release_dir/episode.yaml")
if [[ ! "$handoff_episode_id" =~ ^[a-z0-9][a-z0-9-]{1,62}$ ]]; then
  echo "release handoff has an invalid episode id" >&2
  exit 64
fi
# `prepare --refresh-existing` may replace a pre-merge handoff package, but it
# must never replace one that has reached the publication branch. Refresh the
# remote-tracking ref first, then require both the local base and this feature
# branch to be current with that exact publication ref. An unavailable or
# stale ref is a safety failure, not evidence that an episode is unpublished.
if ! git fetch --quiet origin refs/heads/main:refs/remotes/origin/main; then
  echo "unable to refresh origin/main; refusing to stage without a current publication reference" >&2
  exit 65
fi
if ! publication_ref=$(git rev-parse --verify 'origin/main^{commit}' 2>/dev/null); then
  echo "origin/main does not resolve to a publication commit; refusing to stage" >&2
  exit 65
fi
if ! local_main_ref=$(git rev-parse --verify 'main^{commit}' 2>/dev/null); then
  echo "local main does not resolve to a commit; refusing to stage" >&2
  exit 65
fi
if [[ "$local_main_ref" != "$publication_ref" ]]; then
  echo "local main is not current with origin/main; sync main and create a fresh feature branch before staging" >&2
  exit 65
fi
if ! git merge-base --is-ancestor "$publication_ref" HEAD; then
  echo "current branch does not include the current origin/main; rebase or recreate it before staging" >&2
  exit 65
fi
if git cat-file -e "origin/main:episodes/$handoff_episode_id/episode.yaml" 2>/dev/null; then
  echo "refusing to refresh an episode already present on origin/main: $handoff_episode_id" >&2
  exit 65
fi

mise exec -- go run ./cmd/pplsite verify-handoff --source "$release_dir" --audio "$release_dir/audio.mp3"

: "${R2_ENDPOINT:?set R2_ENDPOINT to https://<account-id>.r2.cloudflarestorage.com}"
: "${PPL_R2_STAGING_BUCKET:?set PPL_R2_STAGING_BUCKET}"
: "${AWS_ACCESS_KEY_ID:?set AWS_ACCESS_KEY_ID for the limited R2 staging credential}"
: "${AWS_SECRET_ACCESS_KEY:?set AWS_SECRET_ACCESS_KEY for the limited R2 staging credential}"
export AWS_DEFAULT_REGION="${AWS_DEFAULT_REGION:-auto}"

if ! command -v aws >/dev/null 2>&1; then
  echo "AWS CLI v2 is required for S3-compatible R2 uploads" >&2
  exit 69
fi

prepare_output=$(mise exec -- go run ./cmd/pplsite prepare --source "$release_dir" --audio "$release_dir/audio.mp3" --out episodes --refresh-existing)
printf '%s\n' "$prepare_output"

episode_id=$(awk -F= '$1 == "episode_id" { print $2 }' <<<"$prepare_output")
staging_key=$(awk -F= '$1 == "staging_key" { print $2 }' <<<"$prepare_output")
sha256=$(awk -F= '$1 == "sha256" { print $2 }' <<<"$prepare_output")
audio_bytes=$(awk -F= '$1 == "bytes" { print $2 }' <<<"$prepare_output")

if [[ -z "$episode_id" || -z "$staging_key" || -z "$sha256" || -z "$audio_bytes" ]]; then
  echo "publisher did not return the expected release metadata" >&2
  exit 70
fi

if staged_identity=$(aws s3api head-object --bucket "$PPL_R2_STAGING_BUCKET" --key "$staging_key" --endpoint-url "$R2_ENDPOINT" --query '[ContentLength, Metadata.sha256]' --output text 2>/dev/null); then
  read -r staged_bytes staged_sha256 <<<"$staged_identity"
  if [[ "$staged_bytes" != "$audio_bytes" || "$staged_sha256" != "$sha256" ]]; then
    echo "refusing to reuse staging object with a different audio identity: $staging_key" >&2
    exit 65
  fi
  echo "Reused verified private staging audio: $staging_key"
else
  aws s3 cp "$release_dir/audio.mp3" "s3://$PPL_R2_STAGING_BUCKET/$staging_key" \
    --endpoint-url "$R2_ENDPOINT" \
    --content-type audio/mpeg \
    --cache-control 'no-store' \
    --metadata "sha256=$sha256"
fi

echo ""
echo "Staged private audio and prepared episodes/$episode_id/."
echo "Review it, then create a release PR. Merging that PR into main publishes the episode."
